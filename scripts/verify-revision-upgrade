#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

die() {
  printf 'REVISION_UPGRADE_PREFLIGHT: %s; behavior NOT_RUN\n' "$*" >&2
  exit 1
}

seed_source=a827457f999646394518c640d7c21915e1321496
writer_base=bbf0ecbda123229a588c29445d132d4ee5c370a6
script_directory=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
repository_root=$(cd "$script_directory/.." && pwd -P)
go_command=${GO:-go}
command -v "$go_command" >/dev/null || die 'Go executable required'
command -v timeout >/dev/null || die 'bounded command runner required'
command -v sha256sum >/dev/null || die 'SHA256 tool required'
git -C "$repository_root" cat-file -e "$seed_source^{commit}" 2>/dev/null || die 'fixed historical source missing; fetch full repository history before verification'

# Export exactly the retained historical commit, never the current writer or a
# developer's scratch copy. No fetch, tidy, source patch, or product fallback.
temporary_base=$(cd "${TMPDIR:-/tmp}" && pwd -P)
seed_directory=$(mktemp -d "$temporary_base/ani-revision-upgrade.XXXXXX")
cleanup() {
  case ${seed_directory:-} in
    "$temporary_base/ani-revision-upgrade."*) rm -rf -- "$seed_directory" ;;
    *) printf 'REVISION_UPGRADE_CLEANUP: refusing unexpected temporary path\n' >&2 ;;
  esac
}
trap cleanup EXIT
mkdir "$seed_directory/old-source"
git -C "$repository_root" archive "$seed_source" | tar -x -C "$seed_directory/old-source"
printf '%s\n' "$seed_source" > "$seed_directory/source"
if (
  cd "$seed_directory/old-source"
  export GOWORK=off
  timeout --signal=TERM --kill-after=10 180 "$go_command" test -c -mod=readonly -trimpath -tags=revisionseed \
    -o "$seed_directory/old-writer.test" ./internal/data/submission
); then
  :
else
  build_exit=$?
  printf 'REVISION_UPGRADE_PREFLIGHT: fixed old writer build failed with exit %s; behavior NOT_RUN\n' "$build_exit" >&2
  exit "$build_exit"
fi
sha256sum "$seed_directory/old-writer.test" | awk '{print $1}' > "$seed_directory/binary.sha256"
printf 'REVISION_UPGRADE_BUILD: source=%s writer_base=%s binary_sha256=%s\n' \
  "$seed_source" "$writer_base" "$(cat "$seed_directory/binary.sha256")"
"$go_command" version

# Missing seed inputs also fail inside the tagged tests. Ordinary go test ./...
# deliberately excludes this lane; make verify always invokes it explicitly.
cd "$repository_root"
CPU_P01_REVISION_SEED_DIRECTORY="$seed_directory" GOWORK=off \
  timeout --signal=TERM --kill-after=10 180 "$go_command" test -mod=readonly -count=1 -v -tags=revisionupgrade \
  -run '^TestOwnerRevision(UpgradeFromOldWriter|MigrationRejectsInvalidHistory)$' \
  ./internal/data/submission ./internal/testsupport/postgres
